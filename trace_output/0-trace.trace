17, 17, 0.85), rgba(17, 17, 17, 0.95)), url('img/gym_background_bw.jpg');\n            background-size: cover;\n            background-position: center;\n            background-attachment: fixed;\n            color: #fff;\n            font-family: 'Inter', 'Roboto', sans-serif;\n            min-height: 100vh;\n            overflow-y: auto;\n            overflow-x: hidden;\n            width: 100%;\n            position: absolute;\n            top: 0;\n            left: 0;\n            z-index: 999999;\n        }\n        #landing-page .container {\n            max-width: 1000px;\n            margin: 0 auto;\n            padding: 60px 20px;\n        }\n        #landing-page header {\n            text-align: center;\n            margin-bottom: 60px;\n            animation: fadeIn 1s ease-out;\n        }\n        @keyframes pulseGlowBlue {\n            0% { box-shadow: 0 0 10px rgba(0, 191, 255, 0.4), 0 0 20px rgba(0, 191, 255, 0.2); transform: scale(1); }\n            100% { box-shadow: 0 0 20px rgba(0, 191, 255, 0.8), 0 0 40px rgba(0, 191, 255, 0.6); transform: scale(1.05); }\n        }\n        #landing-page .hero-logo {\n            width: 160px;\n            height: 160px;\n            border-radius: 50%;\n            object-fit: cover;\n            margin-bottom: 30px;\n            animation: pulseGlowBlue 2s infinite alternate ease-in-out;\n            border: 2px solid rgba(0, 191, 255, 0.5);\n            background-color: #000;\n        }\n        #landing-page h1 {\n            font-size: 3.2em;\n            font-weight: 800;\n            margin: 0;\n            letter-spacing: -1px;\n            color: #fff;\n            text-shadow: 0 2px 10px rgba(0,0,0,0.8);\n        }\n        #landing-page h1 span {\n            color: #FF9800;\n        }\n        #landing-page .subtitle {\n            font-size: 1.3em;\n            color: #ccc;\n            margin-top: 15px;\n            font-weight: 300;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n            text-shadow: 0 2px 5px rgba(0,0,0,0.8);\n        }\n        #landing-page .hero-mockup {\n            width: 100%;\n            max-width: 380px; /* narrowed to simulate phone width for the vertical strip */\n            margin: 40px auto;\n            display: block;\n            border-radius: 30px;\n            box-shadow: 0 20px 60px rgba(0,0,0,0.9);\n            border: 4px solid #333;\n            animation: slideUp 1s ease-out 0.2s both;\n        }\n        #landing-page .install-section {\n            background: rgba(26, 26, 26, 0.9);\n            backdrop-filter: blur(10px);\n            -webkit-backdrop-filter: blur(10px);\n            border-radius: 24px;\n            padding: 50px;\n            margin-top: 80px;\n            text-align: center;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n        }\n        #landing-page .install-section h2 {\n            font-size: 2.2em;\n            margin-top: 0;\n            color: #FF9800;\n            text-shadow: 0 2px 5px rgba(0,0,0,0.5);\n        }\n        #landing-page .install-steps {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 30px;\n            justify-content: center;\n            margin-top: 40px;\n        }\n        #landing-page .step-card {\n            background: rgba(34, 34, 34, 0.8);\n            padding: 30px;\n            border-radius: 16px;\n            flex: 1;\n            min-width: 250px;\n            max-width: 350px;\n            text-align: left;\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n        #landing-page .step-card h3 {\n            margin-top: 0;\n            color: #fff;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n        #landing-page .step-card ol {\n            padding-left: 20px;\n            color: #ddd;\n            line-height: 1.8;\n            marg